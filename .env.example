# URL do projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (anon/public) do Supabase. Segura para expor no browser,
# pois todo acesso passa pelas policies de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role do Supabase. NUNCA expor no cliente — usada só em
# rotas de servidor (app/api/**) para operações que ignoram RLS, como
# criar convites e usuários.
SUPABASE_SERVICE_ROLE_KEY=

# URL base da aplicação, usada para montar links (ex.: /definir-senha?token=...)
# enviados por email. Em produção, a URL pública do deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave da API do Resend (envio de email transacional).
# Ainda não usada na Fase 1 — lib/email.ts apenas loga no console.
RESEND_API_KEY=
